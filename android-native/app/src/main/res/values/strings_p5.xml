    <!-- Plain-language terms -->
    <string name="tip_fakt_t">Fakt</string>
    <string name="tip_fakt_b">Fakt — haqiqatda bajarilgan ish. Uni maydondagi xodim (usta, prorab) hajm bilan kiritadi. Fakt hali buyurtmachiga topshirilgan degani emas.</string>
    <string name="tip_f2_t">F-2</string>
    <string name="tip_f2_b">F-2 — buyurtmachiga topshirilgan va qabul qilingan ishlar akti. Pul hisob-kitobi shu hujjat bo\'yicha bo\'ladi. Fakt — F-2 ga tayyorlanayotgan ish.</string>
    <string name="tip_smeta_t">Smeta</string>
    <string name="tip_smeta_b">Smeta — obyekt uchun rejalashtirilgan ishlar, ularning hajmi va narxi. Obyekt qiymati shu smetadan olinadi.</string>
    <string name="tip_qqs_t">QQS va ustama</string>
    <string name="tip_qqs_b">Obyekt qiymati avval QQS bilan (QQS — 12 % qo\'shilgan qiymat solig\'i) ko\'rsatiladi. Quyida ikki summa — QQS siz: «ustamali» to\'g\'ridan-to\'g\'ri xarajatga ustama (umumqurilish va boshqa xarajatlar, rejalashtirilgan foyda) qo\'shilgan summa; «ustamasiz» — faqat ish, material va mehnat (to\'g\'ri) xarajati. Hamma summalar serverdan olinadi, telefon o\'zi hisoblamaydi.</string>
    <string name="tip_progress_t">Bajarilish</string>
    <string name="tip_progress_b">Tashqi halqa — fakt (bajarilgan ish) smetaning necha foizi. Ichki halqa — F-2 (qabul qilingan) necha foiz. Foiz 100 dan oshsa — smetadan ko\'p ish bajarilgan.</string>

