<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the dark scheme so there is no white flash before Compose draws. -->
    <style name="Theme.Qurai" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/qurai_bg</item>
        <item name="android:statusBarColor">@color/qurai_bg</item>
        <item name="android:navigationBarColor">@color/qurai_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
