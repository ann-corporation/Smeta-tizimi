{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "build": "tsc -b && tsc -p tsconfig.functions.json && npx cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "tekshir": "node testlar/hammasi.cjs",
    "site-map:generate": "node scripts/generate-site-map.mjs",
    "site-map:check": "node scripts/generate-site-map.mjs --check",
    "korpus": "vitest run src/lib/smeta-anatomiya/korpus",
    "i18n:baza": "node scripts/i18n-baza.mjs",
    "test:perf": "npx cross-env PERF=1 vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.8",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.43.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
