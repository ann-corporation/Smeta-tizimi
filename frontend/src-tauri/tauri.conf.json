{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smeta Tizimi",
  "version": "0.1.0",
  "identifier": "uz.anncorp.smeta",
  "build": {
    "frontendDist": "offline"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Smeta Tizimi", "url": "index.html", "create": false, "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src https://smeta-tizimi.pages.dev; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
